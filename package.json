{
	"name": "monei-woocommerce",
	"version": "7.1.3",
	"main": "index.js",
	"repository": "git@github.com:MONEI/MONEI-WooCommerce.git",
	"author": "MONEI <support@monei.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"format:check": "prettier --check .",
		"lint:css": "wp-scripts lint-style",
		"lint:css-fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js-fix": "wp-scripts lint-js --fix",
		"lint:php": "composer lint",
		"lint:php:phpcs": "composer phpcs",
		"lint:php:phpstan": "composer phpstan",
		"lint:php:fix": "composer phpcbf",
		"lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:php && pnpm run format:check",
		"lint:fix": "pnpm run format && pnpm run lint:js-fix && pnpm run lint:css-fix && pnpm run lint:php:fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "playwright test --config=tests/playwright/playwright.config.js",
		"test:e2e:seed": "node tests/playwright/seed.js",
		"test:e2e:start": "wp-env start && node tests/playwright/seed.js",
		"test:e2e:stop": "wp-env stop",
		"test:unit": "wp-scripts test-unit-js",
		"release": "release-it",
		"prepare": "husky",
		"i18n:make-pot": "vendor/bin/wp i18n make-pot . languages/monei.pot --domain=monei --exclude=node_modules,vendor,tests",
		"i18n:make-mo": "for po_file in languages/*.po; do vendor/bin/wp i18n make-mo \"$po_file\"; done",
		"i18n:update": "pnpm run i18n:make-pot && pnpm run i18n:make-mo"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@playwright/test": "^1.62.1",
		"@release-it/bumper": "^7.0.5",
		"@release-it/conventional-changelog": "^10.0.1",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.3.2",
		"@wordpress/env": "^11.13.0",
		"@wordpress/jest-preset-default": "^14.0.0",
		"@wordpress/prettier-config": "^3.0.0",
		"@wordpress/scripts": "^30.24.0",
		"conventional-changelog-cli": "^5.0.0",
		"dotenv": "^17.4.2",
		"eslint-plugin-react-hooks": "^7.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.3",
		"prettier": "npm:wp-prettier@3.0.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"release-it": "^19.0.5"
	},
	"packageManager": "pnpm@11.21.0"
}

# Public URL of the site the E2E suite drives and pays on.
MONEI_E2E_BASE_URL=https://your-tunnel.ngrok-free.dev

# docker-compose directory of that SAME site. WP-CLI changes settings and
# coupons here, so a value pointing at a different site would reconfigure one
# site while paying on another.
MONEI_E2E_WP_DIR=/path/to/your/woocommerce

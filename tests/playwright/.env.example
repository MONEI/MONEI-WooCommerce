# Test mode API key of the MONEI account the suite pays with. Required.
# Seeding stops on a live mode key: the suite takes real payments.
MONEI_TEST_API_KEY=

# Optional. Cross-checked against the account the key belongs to, so a key and
# an id that disagree stop the run instead of paying from the wrong account.
# MONEI_TEST_ACCOUNT_ID=

# Optional: run against a site you already have instead of wp-env.
# Required together — the suite pays through the browser and reconfigures the
# site through WP-CLI, so a value on only one of them could take real payments
# on one site while changing settings on another.
# MONEI_E2E_WP_DIR=/path/to/your/woocommerce
# MONEI_E2E_BASE_URL=https://your-tunnel.ngrok-free.dev
